                },
                {
                  "type": "text",
                  "id": "iO5eQ",
                  "name": "RuleseveryonefollowsLine1",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "One accent, Glacier, used sparingly. Status colours only for states.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-body",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "TJ9IP",
                  "name": "RuleseveryonefollowsLine2",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Formal English, sentence case. No contractions, slang, em dash, middle dot or emoji in the UI.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-body",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "O0VrPO",
                  "name": "RuleseveryonefollowsLine3",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Geist Mono only for addresses and hashes.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-body",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "nUhnq",
                  "name": "RuleseveryonefollowsLine4",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Every claim links to its proof. Never show a transaction for something refused that has none.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-body",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
