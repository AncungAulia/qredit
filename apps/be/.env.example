# Supabase Postgres, session pooler URI (Project → Connect → Session pooler).
DATABASE_URL=
# Shared secret the engine sends as "Authorization: Bearer <token>"; at least 32 characters.
ENGINE_TOKEN=
# Salt for hashing client IPs in the faucet log; at least 16 characters.
IP_SALT=
# Key specs as JSON: {"mnemonic":"..."} or {"privateKey":"0x...","recoveryCode":"QRC1-..."}.
RELAYER_KEY=
TREASURY_KEY=
# JSON array of key specs, one per agent operator account.
OPERATOR_KEYS=[]
PORT=8787
CORS_ORIGINS=http://localhost:3000,https://app.qredit.fun,https://qredit.fun

# Optional, shown with their defaults.
# QORE_CHAIN_ID=qorechain-diana
# QORE_REST_URL=https://api-testnet.qore.host
# QORE_RPC_URL=https://rpc-testnet.qore.host
# QORE_EVM_URL=https://evm-testnet.qore.host
# FAUCET_UQOR=2000000
# FAUCET_FUSD_UNITS=50000000
# FAUCET_COOLDOWN_HOURS=24
# WATCH_INTERVAL_MS=4000
# WINDOW_CHECK_INTERVAL_MS=300000
# WINDOW_MIN_BLOCKS=3600
# WINDOW_MAX_TXS=500
# WINDOW_MAX_UQOR=25000000
